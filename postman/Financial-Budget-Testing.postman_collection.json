		{
			"name": "Azure AI Foundry Red Team",
			"description": "Cloud red team evaluation via Azure AI Foundry.\n\nRequires USE_AZURE_RED_TEAM=true and AZURE_AI_PROJECT_ENDPOINT set.\nAll requests return HTTP 501 when Azure credentials are not configured.\nWith USE_MOCK_DATA=true the mock backend returns deterministic results immediately.",
			"item": [
				{
					"name": "Upload FCA Taxonomy",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"scenario_id\": \"fca-consumer-duty\",\n  \"prohibited\": [],\n  \"high_risk\": [],\n  \"irreversible\": [],\n  \"version\": \"1.0.0\",\n  \"last_updated\": \"2026-04-22\"\n}"
						},
						"url": {
							"raw": "{{ADVERSARIAL_TESTER_URL}}/api/v1/adversarial/taxonomy",
							"host": [
								"{{ADVERSARIAL_TESTER_URL}}"
							],
							"path": [
								"api",
								"v1",
								"adversarial",
								"taxonomy"
							]
						},
						"description": "Registers a ProhibitedActionsTaxonomy with Azure AI Foundry.\nReturns taxonomyFileId to use in run-cloud requests.\n⚠️  Requires Azure credentials — returns 501 without them."
					},
					"response": []
				},
				{
					"name": "Run Cloud Eval (mock)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"agentName\": \"{{AZURE_AI_AGENT_NAME}}\",\n  \"agentVersion\": \"{{AZURE_AI_AGENT_VERSION}}\",\n  \"attackStrategies\": [\"Base64\", \"Flip\", \"ROT13\", \"Leetspeak\"],\n  \"riskCategories\": [\"PROHIBITED_ACTIONS\", \"SENSITIVE_DATA_LEAKAGE\"],\n  \"numTurns\": 5,\n  \"taxonomyId\": \"{{TAXONOMY_ID}}\"\n}"
						},
						"url": {
							"raw": "{{ADVERSARIAL_TESTER_URL}}/api/v1/adversarial/run-cloud",
							"host": [
								"{{ADVERSARIAL_TESTER_URL}}"
							],
							"path": [
								"api",
								"v1",
								"adversarial",
								"run-cloud"
							]
						},
						"description": "Creates a PyRIT red team eval run via Azure AI Foundry.\nWith USE_MOCK_DATA=true returns a deterministic completed run immediately.\n⚠️  Requires Azure credentials for the real backend — returns 501 without them."
					},
					"response": []
				}
			]
